# ====================================================================
# Voice AI Agent — Backend Configuration
# Copy this file to `.env` and fill in your values.
#   cp .env.example .env   (macOS/Linux)
#   copy .env.example .env (Windows)
# ====================================================================

# --- Google Gemini (required) -----------------------------------------------
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model used to parse intent and write emails (optional — sensible defaults).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_SECONDS=30

# --- Gmail SMTP (required to actually send email) ---------------------------
# Use a Gmail *App Password*, NOT your normal password.
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:      https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# SMTP server settings (defaults work for Gmail).
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# --- Application ------------------------------------------------------------
# Comma-separated list is also accepted by pydantic-settings as JSON.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=INFO
CONVERSATION_HISTORY_LIMIT=10
